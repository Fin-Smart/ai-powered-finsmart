EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google sign-in (Google Cloud console > APIs & Services > Credentials > OAuth client IDs).
# Web client ID: used by Firebase Auth. iOS client ID: also sets the iOS URL scheme in app.config.js.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Local development only. Create in Firebase console > App Check > Apps > (web app) > Manage debug tokens.
# Never add this to EAS environment variables or commit it.
EXPO_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
