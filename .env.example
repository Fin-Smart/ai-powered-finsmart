# Firebase is configured natively from google-services.json and GoogleService-Info.plist.

# Google sign-in: the "Web client" OAuth client ID (client_type 3 in google-services.json).
# The iOS client ID is read from GoogleService-Info.plist.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Development builds only. Register it for the iOS and Android apps in
# Firebase console > App Check > Apps > Manage debug tokens. Never add it to production EAS env.
EXPO_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
